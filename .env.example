# Настройки «Генератора лидмагнитов». Скопируйте в .env и заполните (install.sh делает это сам).
# Пустая строка — значение не задано. Секреты в .env никому не показывайте и в git не кладите.

# ── Адрес и вход ────────────────────────────────────────────────────────────

# Адрес, по которому открывают кабинет. На своём компьютере — http://localhost:3000,
# на сервере — https://ваш-домен. Нужен для ссылок и вебхуков мессенджеров.
PUBLIC_BASE_URL=http://localhost:3000

# Домен для встроенного HTTPS (Caddy сам получит сертификат). Только на сервере, иначе пусто.
DOMAIN=

# Способ входа: password — по почте и паролю (по умолчанию), sso — через внешний сервис единого входа.
AUTH_MODE=password

# Почты, которым разрешён вход в кабинет, через запятую. Пароль для почты задаёт команда set-password.
ALLOWED_EMAILS=

# Ключ шифрования cookie входа: случайная строка от 32 символов (openssl rand -hex 32).
# Смена ключа выводит всех из кабинета.
AUTH_COOKIE_SECRET=

# Только для AUTH_MODE=sso: адрес сервиса входа, адрес этого приложения и его id клиента.
AUTH_URL=
AUTH_APP_URL=
AUTH_CLIENT_ID=

# ── База и хранилище ────────────────────────────────────────────────────────

# Пароль базы PostgreSQL в Docker (только буквы и цифры: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Адрес базы. В Docker Compose задаётся сам из POSTGRES_PASSWORD — здесь оставьте пустым.
# Без Docker: postgres://пользователь:пароль@хост:5432/база
DATABASE_URL=

# Папка для картинок рассылок. В Docker — /app/data/uploads (том app-data), менять не нужно.
UPLOADS_DIR=

# Ключ шифрования токенов ботов: 32 случайных байта в base64 (openssl rand -base64 32).
# Не меняйте после подключения ботов: старые токены перестанут расшифровываться.
BOT_TOKEN_KEY=

# ── Модели ──────────────────────────────────────────────────────────────────

# DeepSeek — основная модель (platform.deepseek.com → API keys). Обязательно.
DEEPSEEK_API_KEY=
# Запасные провайдеры той же модели, если DeepSeek не отвечает. Необязательно.
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Свой прокси к провайдерам (если из вашей страны они закрыты). Обычно пусто.
DEEPSEEK_BASE_URL=
TOGETHER_BASE_URL=
OPENROUTER_BASE_URL=
# Значение заголовка X-Proxy-Token для этого прокси.
PROXY_TOKEN=

# Firecrawl — консультант открывает ссылки, которые присылает человек (firecrawl.dev). Необязательно.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=

# ── Мессенджеры ─────────────────────────────────────────────────────────────
# Ботов Telegram, MAX и сообщества VK подключают в кабинете (раздел «Боты»), не здесь.

# Свой адрес Telegram Bot API (если api.telegram.org закрыт). Обычно пусто.
TELEGRAM_API_BASE_URL=
# Другой адрес для вебхуков Telegram. Пусто — PUBLIC_BASE_URL.
TELEGRAM_WEBHOOK_BASE_URL=

# Отдельный бот Telegram для тревог о сбоях (создайте у @BotFather). Кому слать — в настройках кабинета.
ALERT_BOT_TOKEN=

# ── GetCourse ───────────────────────────────────────────────────────────────

# Секрет в адресе уведомлений о заказах: PUBLIC_BASE_URL/api/integrations/getcourse/<секрет>.
# Длинная случайная строка (openssl rand -hex 24). Пусто — приём заказов выключен.
GETCOURSE_WEBHOOK_SECRET=
