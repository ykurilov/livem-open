{
  "name": "live-lead-magnets",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "measure:consultant": "tsx --env-file-if-exists=.env.local scripts/measure-consultant-latency.ts",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "eval:recheck": "tsx evals/recheck-run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/modules/platform/migrate.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.js",
    "lm": "tsx --env-file-if-exists=.env.local scripts/lead-magnet-cli.ts",
    "password:set": "tsx --env-file-if-exists=.env.local scripts/set-password.ts",
    "flows:adopt": "tsx --env-file-if-exists=.env.local scripts/adopt-running-chats.ts",
    "flows:rollback": "tsx --env-file-if-exists=.env.local scripts/rollback-flows.ts",
    "cli:build": "esbuild scripts/lead-magnet-cli.ts scripts/adopt-running-chats.ts scripts/rollback-flows.ts scripts/set-password.ts --bundle --platform=node --format=esm --packages=external --outdir=dist"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tandem/ui": "npm:@ykurilov/tandem-ui@^0.7.0",
    "@ykurilov/agent-chat-core": "0.87.14",
    "@ykurilov/agent-chat-flows": "0.87.14",
    "@ykurilov/agent-chat-image-library": "0.87.14",
    "@ykurilov/agent-chat-limits": "0.87.14",
    "@ykurilov/agent-chat-react": "0.87.14",
    "@ykurilov/agent-chat-reply-check": "0.87.14",
    "@ykurilov/agent-chat-server": "0.87.14",
    "@ykurilov/agent-chat-skin-oduvanchik": "0.87.14",
    "@ykurilov/agent-chat-storage-postgres": "0.87.14",
    "@ykurilov/agent-chat-videos": "0.87.14",
    "@ykurilov/agent-chat-web-tools": "0.87.14",
    "@ykurilov/ds-react": "0.3.0",
    "@ykurilov/ds-tokens": "0.2.0",
    "ai": "7.0.122",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "1.33.0",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.19",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
